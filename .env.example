# specs que nÃ£o tÃªm nada a ver com autenticaÃ§Ã£o.
#
# O teto por CONTA (5 falhas na mesma conta em 5 min) NÃƒO Ã© configurÃ¡vel de
# propÃ³sito â€” Ã© ele que barra brute force, inclusive distribuÃ­do por vÃ¡rios IPs.
# Valor invÃ¡lido ou ausente cai no default: a falha Ã© fechada.
# AUTH_RATE_LIMIT_LOGIN_IP=1000

# RetenÃ§Ã£o do arquivo do corpo cru dos webhooks (webhook_events_log).
# 7 dias mantÃ©m o banco dentro dos 500 MB do plano gratuito do Supabase; o
# arquivo era 86% do banco numa instalaÃ§Ã£o real, crescendo ~23 MB/dia.
