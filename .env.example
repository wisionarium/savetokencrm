# --- Teto de gasto de IA: a alavanca de emergÃªncia ----------------------------
# Quem escolhe o teto Ã© cada organizaÃ§Ã£o, na tela Uso de IA â€º OrÃ§amento (teto,
# aviso, e se a IA deve PARAR ao chegar nele). Esta chave nÃ£o escolhe nada: ela
# sÃ³ sabe AFROUXAR o que jÃ¡ foi escolhido.
#   on      (default) respeite o que cada organizaÃ§Ã£o escolheu
#   avisar  rebaixa qualquer "parar a IA" para apenas avisar
#   off     desliga a proteÃ§Ã£o nesta instalaÃ§Ã£o inteira
# TambÃ©m valem, como off: false, 0, no, nao, nÃ£o, disabled. Valor nÃ£o
# reconhecido cai em `on` â€” de propÃ³sito: a alavanca de emergÃªncia NUNCA pode
# derrubar o app por um typo. Mudou AQUI? reinicie o app e o worker (a tela nÃ£o
# pede reinÃ­cio).
#
# O BANCO ESTÃ ACIMA DESTA LINHA. A tela /admin/sistema â€º Comportamento
# ("ProteÃ§Ã£o de gasto de IA") grava a escolha em `platform_settings`, e Ã© ela
# que vale a partir daÃ­. Esta variÃ¡vel Ã© o PISO: ela responde quando a
# instalaÃ§Ã£o nunca abriu a tela e quando o app subiu e ainda nÃ£o conseguiu ler o
# banco â€” a janela em que uma instalaÃ§Ã£o desprotegida de propÃ³sito voltaria a
# bloquear sozinha. Ver lib/instalacao/comportamento.ts.
AI_BUDGET_ENFORCEMENT=on

# â”€â”€ Comportamento da instalaÃ§Ã£o que o MOTOR lÃª (o banco estÃ¡ acima) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# As duas chaves abaixo tÃªm casa na mesma tela â€” /admin/sistema â€º Comportamento
# â€” e o `.env` Ã© o PISO delas, no mesmo molde do SIGNUP_MODE: a escolha salva na
# tela vive em `platform_settings` e vence sem reiniciar nada; o que estÃ¡ aqui
# responde quando a instalaÃ§Ã£o nunca abriu a tela e quando o processo subiu e
# ainda nÃ£o conseguiu ler o banco. Vazio = o padrÃ£o do produto, que Ã© o de
# sempre (`inject` e `true`).
#
# `inject` (padrÃ£o) acrescenta o texto de divulgaÃ§Ã£o de pagamento Ã  primeira
# mensagem; `veto` bloqueia o envio sem ele e devolve ao modelo a razÃ£o, para
# ele reescrever. Vazio ou valor nÃ£o reconhecido = `inject`.
DISCLOSURE_MODE=
# "true" (padrÃ£o) faz CADA envio passar por uma conferÃªncia de modelo antes de
# sair, para nÃ£o prometer o que a empresa nÃ£o cumpre â€” custa uma chamada de
# modelo por envio. Vazio = `true`; `false` desliga.
PROMISE_SEMANTIC_ENABLED=

# --- Workers -----------------------------------------------------------------
# Ritmo com que o WORKER roda os handlers do event_log (mÃ­dia, branding,
# follow-upâ€¦). Antes destes knobs os handlers sÃ³ rodavam pelo cron
# `event-log-drain`, 1Ã—/min â€” e a cadeia persistâ†’derive de um Ã¡udio levava
# 103-188s contra os 45s que o turno espera pela transcriÃ§Ã£o. O cron continua
# ligado como rede de seguranÃ§a. Vazio = os defaults abaixo.
EVENT_LOG_DRAIN_INTERVAL_MS=2000
EVENT_LOG_DRAIN_IDLE_INTERVAL_MS=10000
EVENT_LOG_DRAIN_BATCH_SIZE=50

# --- Elegibilidade da IA por origem do lead ----------------------------------
# Vale SÃ“ nos canais em que vocÃª ligou o modo "sÃ³ atende quem eu autorizei"
# (ConfiguraÃ§Ãµes do canal â€º ai_gate = allowlist). Nesses canais, um contato fica
# elegÃ­vel para a IA quando vem de uma origem conhecida (formulÃ¡rio do Respondi,
# campanha, liberaÃ§Ã£o manual). Este nÃºmero Ã© por quantos DIAS essa autorizaÃ§Ã£o
# vale â€” depois disso, uma submissÃ£o antiga nÃ£o reativa a IA sozinha. Uma
# conversa que segue viva renova o prazo a cada turno. Vazio = 21 dias.
AI_ALLOWLIST_TTL_DAYS=21
# Stub do endpoint de teste do agente: 'true' devolve trace fabricado em vez de
# executar o agente. Deixe false â€” o runtime real jÃ¡ existe. SÃ³ ligue para
# exercitar o render da UI sem gastar token.
INTERNAL_AGENT_RUN_STUB=false

# --- Sentry ------------------------------------------------------------------
SENTRY_DSN=

# --- E-mail transacional (Resend) ---------------------------------------------
# Convite de time, entrega de export LGPD e alarme de SLA saem por aqui.
#
# RESEND_FROM_EMAIL precisa ser um endereÃ§o de um domÃ­nio VERIFICADO na SUA
# conta Resend. Vazio = e-mail desligado (o convite mostra o link de aceite na
