# --- Legado WAHA (removido; Meta Cloud/Zernio no lugar) -----------------------
# Mantido comentado para `.env` antigos subirem sem editar. Nao configure.
# WAHA_API_BASE_URL=
# WAHA_API_KEY=
# WAHA_HMAC_SECRET=

# â”€â”€â”€ Chamada de voz WhatsApp (WaCalls, spec 18) â€” DESLIGADA POR PADRÃƒO â”€â”€â”€â”€â”€â”€â”€
#
# LigÃ¡-la vincula um SEGUNDO APARELHO ao mesmo nÃºmero que jÃ¡ atende, por um
# caminho que nÃ£o Ã© o oficial: o risco Ã© a CONTA ser bloqueada pelo WhatsApp,
# nÃ£o sÃ³ o aparelho. Por isso nada aqui vem preenchido, e cada organizaÃ§Ã£o
# ainda precisa aceitar o risco na tela (ConfiguraÃ§Ãµes â€º SeguranÃ§a).
#
# Em produÃ§Ã£o o serviÃ§o vive num profile do compose que nasce desligado; ligar
# Ã© `COMPOSE_PROFILES=voz` no .env. Vazio aqui = a feature nÃ£o aparece na tela
# (banner, nunca erro).
WACALLS_API_BASE_URL=
# Bearer que o app usa para falar com o serviÃ§o. O WaCalls autenticado NÃƒO tem
# modo aberto: sem token, a API sÃ³ aceita o cookie de login do navegador, que um
# processo server-to-server nÃ£o tem. URL sem token = 401 em toda chamada.
WACALLS_API_TOKEN=
# O contÃªiner precisa de DUAS coisas para o Ã¡udio sair da rede local â€” e sem
# elas a ligaÃ§Ã£o toca, conecta e fica MUDA na VPS (o WaCalls anuncia como
# candidato o IP interno do contÃªiner, 172.x, que navegador nenhum alcanÃ§a):
#   WACALLS_PUBLIC_IP        o IP pÃºblico da VPS, anunciado como candidato ICE
#   WACALLS_WEBRTC_UDP_PORT  a porta UDP fixa (sem ela, portas efÃªmeras
#                            aleatÃ³rias, impossÃ­veis de publicar no compose)
# As duas sÃ£o do CONTÃŠINER, nÃ£o do app â€” por isso vivem aqui e nÃ£o em lib/env.ts.
WACALLS_PUBLIC_IP=
WACALLS_WEBRTC_UDP_PORT=7881
# Legado WAHA (removido). Piso antigo de assinatura de webhook; sem efeito.
# WAHA_WEBHOOK_REQUIRE_SIGNATURE=false
# Legado WAHA (removido). URL publica que o transporte QR chamava; sem efeito.
# WAHA_WEBHOOK_BASE_URL=
# Legado WAHA (removido). Retomada de sessoes do container; sem efeito.
# WHATSAPP_RESTART_ALL_SESSIONS=True

# --- OpenRouter: atribuiÃ§Ã£o OPCIONAL ----------------------------------------
