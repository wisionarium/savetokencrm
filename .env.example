# â”€â”€ Quem pode criar conta nesta instalaÃ§Ã£o â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# `aberto` (padrÃ£o, e o comportamento de sempre) ou `so_convite`. Vazio =
# `aberto`: nada muda para quem nÃ£o mexer aqui.
#
# O BANCO ESTÃ ACIMA DESTA LINHA. Assim que alguÃ©m usa a tela em
# /admin/cadastro, a escolha passa a viver em `platform_settings` e Ã© ela que
# vale. Esta variÃ¡vel Ã© o PISO: ela responde quando a instalaÃ§Ã£o nunca abriu a
# tela, e quando o app subiu e ainda nÃ£o conseguiu ler o banco â€” que Ã© a razÃ£o
# de ela existir, porque sem um piso declarado uma instalaÃ§Ã£o fechada de
# propÃ³sito abriria nessa janela.
#
# Fechado, /signup recusa com tela (marca e idioma da instalaÃ§Ã£o) quem chega
# sem convite; quem chega COM convite vÃ¡lido entra igual. Ver
# lib/auth/politica-de-cadastro.ts.
SIGNUP_MODE=

# â”€â”€ Idioma com que a instalaÃ§Ã£o NASCE â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# `pt-BR` (padrÃ£o) ou `es`. Quem pergunta Ã© o install.sh; quem grava Ã© ele
# mesmo (ou o scripts/bootstrap-owner.ts, no caminho local), em
# `organizations.locale` E na preferÃªncia do usuÃ¡rio dono.
#
# âš ï¸ NÃƒO Ã© lido pelo app em runtime, e por isso nÃ£o estÃ¡ em `lib/env.ts`: mudar
# esta linha depois da instalaÃ§Ã£o nÃ£o muda a interface de ninguÃ©m. Trocar o
# idioma de quem jÃ¡ estÃ¡ instalado Ã© pela TELA â€” no seletor do topo (sÃ³ para
# vocÃª) ou em ConfiguraÃ§Ãµes â€º OrganizaÃ§Ã£o (para quem entrar sem preferÃªncia).
APP_LOCALE=pt-BR

# --- WhatsApp Cloud API (Meta) ---
# Opcionais: sem elas o canal oficial simplesmente nao e configurado.
# O servidor e a nuvem da Meta (sem container).
META_APP_ID=
# App Secret: chave do HMAC SHA-256 que valida os webhooks (X-Hub-Signature-256).
# RESERVA, desde a migration 0257: o caminho normal Ã© a tela Admin â€º API Oficial
# (Meta), que guarda a chave cifrada no banco e gera o verify token. O banco
# vence o .env; o par daqui sÃ³ vale enquanto a tela nÃ£o tiver um par completo.
META_APP_SECRET=
META_WABA_ID=
META_PHONE_NUMBER_ID=
META_SYSTEM_USER_TOKEN=
# Token que a Meta devolve no handshake (hub.verify_token) para provar que o
# endpoint Ã© seu. RESERVA, como o App Secret acima: pela tela Admin â€º API Oficial
# (Meta) o servidor o gera sozinho. SÃ³ preencha aqui se nÃ£o for usar a tela â€” e
# nunca com um valor adivinhÃ¡vel. Sem token nenhum, o GET de verificaÃ§Ã£o responde 403.
META_WEBHOOK_VERIFY_TOKEN=
# VersÃ£o da Graph API. ExplÃ­cita de propÃ³sito: bump Ã© decisÃ£o, nÃ£o deriva.
META_GRAPH_VERSION=v22.0

# --- Canal via intermediÃ¡rio (BSP) â€” opcional ---
# Deixe em branco se vocÃª nÃ£o usa este canal; nada quebra sem estas trÃªs.
#
# As DUAS de baixo andam juntas: o adapter sÃ³ se considera configurado com as
# duas preenchidas. Preencher sÃ³ uma nÃ£o Ã© meio-caminho â€” Ã© o estado que fazia a
# mensagem ser marcada como enviada sem sair, e por isso a checagem agora exige
# o par. A credencial tambÃ©m pode viver na SESSÃƒO (cifrada), e aÃ­ estas ficam
# vazias.
ZERNIO_ACCOUNT_ID=
ZERNIO_API_KEY=
# SÃ³ para apontar para homologaÃ§Ã£o. Vazio usa a produÃ§Ã£o do provedor.
ZERNIO_API_BASE_URL=

# --- Teto de login por IP (SÃ“ para CI de e2e) ---
# NÃƒO defina isto em produÃ§Ã£o nem numa VPS. O default (60 tentativas por IP a
# cada 5 min) Ã© o valor correto para uso real e jÃ¡ Ã© folgado por causa de NAT.
#
# Existe porque no CI todos os testes saem de UM IP (o runner): 28 specs de e2e
