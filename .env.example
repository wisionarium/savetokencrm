# --- Ritmo da fila do worker (custo de banco) --------------------------------
# Os dois governam quanto o worker conversa com o Postgres quando NÃƒO hÃ¡ trabalho
# â€” a conta que estourou a cota de egress do plano free do Supabase na issue #258.
# Ambos sÃ£o opcionais: sem eles valem os defaults abaixo, que sÃ£o o comportamento
# recomendado. Como ver o que estÃ¡ em vigor: a linha `agent-engine pronto` no log
# do worker imprime os dois. Quando mexer e o que medir:
# docs/runbooks/custo-e-cota-do-supabase.md
#
# TETO de espera do laÃ§o da fila. Com a fila vazia, Ã© quanto o worker dorme entre
# uma consulta e a prÃ³xima; com job agendado, ele acorda no vencimento e este
# valor sÃ³ limita a soneca. NÃ£o passe de 10000: acima disso a conexÃ£o ociosa
# expira entre as rodadas e cada consulta volta a pagar TCP+TLS â€” gasta MAIS.
#QUEUE_POLL_INTERVAL_MS=2000
# Ritmo do "havia trabalho e eu nÃ£o peguei" (todas as vagas de
# QUEUE_MAX_CONCURRENCY ocupadas, ou outro turno rodando para o mesmo contato).
# Aqui hÃ¡ job vencido esperando vaga, entÃ£o este valor Ã© curto de propÃ³sito:
# aumentÃ¡-lo nÃ£o economiza nada no ocioso e custa throughput no pico.
#QUEUE_CLAIM_RETRY_INTERVAL_MS=250

# â”€â”€ RetenÃ§Ã£o do histÃ³rico (poda diÃ¡ria, cron `data-retention`) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# EspaÃ§o em disco Ã© uma cota diferente da de trÃ¡fego: o plano free do Supabase
# limita 500 MB de BANCO, e `job_queue` + `api_audit_log` sÃ£o as duas que crescem
# sozinhas. Os dois valores abaixo JÃ SÃƒO os defaults do cÃ³digo: apagar as linhas
# de um `.env` existente nÃ£o muda nada, e quem atualiza sem tocar no arquivo
# recebe exatamente este comportamento. Quanto cada tabela ocupa hoje e o que
# fazer com o nÃºmero: docs/runbooks/custo-e-cota-do-supabase.md
#
# Idade a partir da qual um job TERMINAL (done/failed/dead) Ã© apagado. Job
# `pending`/`running` NUNCA Ã© tocado â€” tem trabalho dentro. Apagar um job leva
# junto o `send_ledger` e o `before_send_traces` daquele run. Piso de 7 dias,
# aplicado dentro da funÃ§Ã£o do banco (valor menor Ã© elevado, com aviso no log).
JOB_QUEUE_RETENTION_DAYS=90
# Idade a partir da qual uma linha de auditoria Ã© expurgada. O default Ã© a
# retenÃ§Ã£o de 5 anos da regra L-10. Piso de 90 dias: nem com a chave de serviÃ§o
# esta poda alcanÃ§a rastro recente. Diminuir aqui Ã© a alavanca de quem estÃ¡
# apertado de espaÃ§o e aceita guardar menos histÃ³rico.
AUDIT_LOG_RETENTION_DAYS=1825
# Idade a partir da qual a conversa da equipe com a IA sobre um caso Ã© apagada.
# Um ano fiscal: depois disso, "por que decidimos assim" Ã© respondido pelos
# eventos do caso, nÃ£o pela deliberaÃ§Ã£o. Piso de 90 dias, aplicado dentro da
# funÃ§Ã£o do banco (valor menor Ã© elevado, com aviso no log).
CASE_CHAT_RETENTION_DAYS=365
# Idade a partir da qual o registro de uma passagem do atendimento para uma
# pessoa Ã© apagado. Cinco anos, o mesmo da auditoria: Ã© o rastro de quem assumiu
# a conversa de quem, quando e por quÃª. Piso de 90 dias, aplicado dentro da
# funÃ§Ã£o do banco â€” e passagem que NINGUÃ‰M reconheceu nunca Ã© apagada, em
# nenhuma idade: ela Ã© uma pessoa ainda esperando resposta.
PASSAGEM_RETENTION_DAYS=1825
# Idade a partir da qual o registro de entrega do aviso de caso no WhatsApp da
# equipe Ã© apagado. Seis meses: a Ãºnica pergunta que essa linha responde â€” "o
# aviso daquele caso saiu?" â€” Ã© de semanas. A linha nÃ£o guarda o texto do aviso,
# sÃ³ um resumo criptogrÃ¡fico dele. Piso de 30 dias, aplicado dentro da funÃ§Ã£o do
# banco (valor menor Ã© elevado, com aviso no log).
CASE_ALERT_RETENTION_DAYS=180

# Chave LLM de plataforma (fallback quando a org nÃ£o tem credencial BYOK
# cadastrada em /app/ai/credentials). Opcional com BYOK.
ANTHROPIC_API_KEY=

# Dono ÃšNICO dos eventos de despacho do agente. 'engine' (default) = o worker
# consome; 'native' = o dispatcher interno do app consome (deploy sem worker).
# NUNCA os dois â€” dois consumidores = turno duplicado ou perdido.
AGENT_DISPATCH_CONSUMER=engine

# Watchdog de sessoes: reenvia mensagens presas em queued (Meta/Zernio).
# Knobs opcionais:
#WATCHDOG_INTERVAL_MS=60000
