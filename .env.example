TENANT_PROVISIONING_SECRET=
# CRON_SECRET nÃ£o Ã© chave deste arquivo: Ã© o nome com que o Vercel Cron injeta o
# Bearer, e vale para quem hospeda um fork lÃ¡. Em produÃ§Ã£o, se ela existir,
